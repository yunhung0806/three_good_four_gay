# Copy to .env and set a project-scoped, rate-limited server-side key to enable AI dialogue.
# Never put this key in the browser or commit .env. Inline comments after whitespace are ignored.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Blank HOST/PORT fall back to 127.0.0.1 / 3000. Bind to 0.0.0.0 only on a trusted network.
HOST=127.0.0.1
PORT=3000
# Optional: exact single browser origin for CORS; blank means same-origin only. Wildcards are not supported.
ALLOWED_ORIGIN=
